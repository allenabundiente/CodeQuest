# ---------- AI providers (OpenAI-compatible APIs) ----------
# Gemini and DeepSeek are routed through OpenRouter, Groq talks to its own endpoint.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash
DEEPSEEK_MODEL=deepseek/deepseek-chat-v3.1
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback order. Providers without a key are skipped automatically.
PROVIDER_ORDER=gemini,deepseek,groq
AI_CACHE_TTL_SECONDS=604800
QUOTA_DAILY_CALLS=40
QUOTA_DAILY_TOKENS=200000
LESSON_STEPS=3
SOLUTION_MAX_ATTEMPTS=2

# ---------- Sandbox (self-hosted Piston or Judge0 CE) ----------
SANDBOX_DRIVER=piston
PISTON_URL=http://localhost:2000
PISTON_LANG_VERSIONS={"python":"3.10.0","javascript":"18.15.0","typescript":"5.0.3","go":"1.16.2","java":"15.0.2","cpp":"10.2.0"}
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
SANDBOX_TIMEOUT_MS=6000
# When true, a lesson is only saved if its solutions pass in the sandbox.
SANDBOX_REQUIRED=true

# ---------- GitHub import ----------
GITHUB_TOKEN=

# ---------- Resend streak emails ----------
RESEND_API_KEY=
RESEND_FROM=CodeQuest <streaks@example.com>
APP_URL=http://localhost:3000
CRON_SECRET=
STREAK_EMAIL_MIN=2

# ---------- Developer / content admin ----------
# Comma-separated emails that receive the developer role on login.
# Required for /admin and for content:import / content:export.
DEVELOPER_EMAILS=you@example.com

# ---------- Releases, PWA, and rollouts ----------
# Build-time version baked into the client and compared against the server.
NEXT_PUBLIC_APP_VERSION=0.4.0
# Builds below this version are blocked behind a required-update screen.
MIN_SUPPORTED_VERSION=0.1.0
# Set to false to disable service-worker registration entirely.
NEXT_PUBLIC_ENABLE_SW=true
# JSON flags, e.g. {"githubImport":false,"pwaUpdates":true}
FEATURE_FLAGS={}

# ---------- Error reporting ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- App ----------
DATABASE_PATH=.data/codequest.db
